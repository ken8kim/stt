#!/usr/bin/env python3
"""stt-relabel — apply human speaker names to an stt output.

Usage:
    stt-relabel output_dir/audio.json --mapping '{"SPEAKER_00":"Alice","SPEAKER_01":"Bob"}'
"""
import os
import subprocess
import sys
from pathlib import Path


def find_skill_dir() -> Path:
    env = os.environ.get("STT_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    for c in [
        Path(__file__).resolve().parent.parent / "skill",
        Path.home() / ".claude" / "skills" / "stt",
        Path("/usr/local/share/stt/skill"),
    ]:
        if (c / "relabel.py").exists():
            return c
    sys.exit("Could not locate skill directory. Set STT_ROOT.")


def main() -> None:
    if len(sys.argv) < 4 or "--mapping" not in sys.argv:
        print(
            'Usage: stt-relabel <output>.json --mapping \'{"SPEAKER_00":"Alice","SPEAKER_01":"Bob"}\'',
            file=sys.stderr,
        )
        sys.exit(2)
    json_path = Path(sys.argv[1]).expanduser().resolve()
    mapping_idx = sys.argv.index("--mapping") + 1
    if mapping_idx >= len(sys.argv):
        sys.exit("--mapping requires a JSON dict argument")
    mapping = sys.argv[mapping_idx]
    skill = find_skill_dir()
    sys.exit(subprocess.call([
        sys.executable, str(skill / "relabel.py"),
        "--json", str(json_path),
        "--mapping", mapping,
    ]))


if __name__ == "__main__":
    main()
